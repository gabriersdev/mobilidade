    "html-react-parser": "^6.1.8",
    "leaflet": "^1.9.4",
    "moment": "^2.31.0",
    "prop-types": "^15.8.1",
    "react": "^19.3.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.0",
    "react-input-mask": "^2.0.4",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.4",
    "rolldown": "1.2.9",
    "semantic-release": "^25.0.9",
    "socket.io-client": "^4.8.3",
    "vercel": "^59.25.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
