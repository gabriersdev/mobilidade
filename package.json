    "srvx": "^0.11.13",
    "glob": "^10.4.1",
    "rimraf": "^5.0.7",
    "react-router": "^8.3.0",
    "npm": {
      "tar": "^7.5.21",
      "brace-expansion": "^5.0.8"
    }
  },
  "sideEffects": [
    "bootstrap/dist/js/bootstrap.bundle.min.js"
  ],
  "allowScripts": {
    "es5-ext@0.10.64": true,
    "esbuild@0.28.2": true,
    "cypress@16.1.0": true
  }
}
