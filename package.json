    "cypress": "^16.1.0",
    "eslint": "^10.11.0",
    "eslint-plugin-cypress": "7.0.2",
    "eslint-plugin-import": "^1.14.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "gh-pages": "^6.3.0",
    "globals": "^17.12.0",
    "globby": "^16.2.4",
    "rollup-plugin-visualizer": "^7.1.1",
    "terser": "^5.51.2",
    "vite": "8.3.0"
  },
